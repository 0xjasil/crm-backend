{
  "version": 2,
  "buildCommand": "npx prisma migrate deploy && npx prisma generate && npx tsc",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{dist/**,src/services/pdf/templates/**,node_modules/@pdfme/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
